PORT=5000
# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Optional server-wide Gemini key. Users can also add their own key in Settings.
GEMINI_API_KEY=
# Optional. gemini-2.0-flash was shut down on 2026-06-01.
GEMINI_MODEL=gemini-2.5-flash
